;; FFI: libc/libSystem only (portable). libuv tests live in spec/ffi-libuv.lisp.
(deftest "ffi: strlen round trip"
  (define libc (ffi-dlopen-self))
  (define strlen (ffi-dlsym libc "strlen"))
  (define s (ffi-cstr "hello"))
  (assert (eq? 5 (ffi-call-i64 strlen (list s) nil))))
(deftest "ffi: getpid"
  (define libc (ffi-dlopen-self))
  (define getpid (ffi-dlsym libc "getpid"))
  (assert (> (ffi-call-i64 getpid nil nil) 0)))
(deftest "ffi: getenv"
  (define libc (ffi-dlopen-self))
  (define getenv (ffi-dlsym libc "getenv"))
  (define path (ffi-cstr "PATH"))
  (define p (ffi-call-i64 getenv (list path) nil))
  (assert (> p 0))
  (assert (not (eq? "" (ffi-string-at p)))))
(deftest "ffi: libm sqrt and mixed args"
  (define libm (try (lambda () (ffi-dlopen "libm.dylib")) (lambda (e) (ffi-dlopen "libm.so.6"))))
  (assert libm)
  (define sqrt (ffi-dlsym libm "sqrt"))
  (define r (ffi-call-f64 sqrt nil (list 4)))
  (assert (< (abs (- r 2)) 1e-9))
  (define r2 (ffi-call-f64 sqrt nil (list 9)))
  (assert (< (abs (- r2 3)) 1e-9))
  (ffi-dlclose libm))
(deftest "ffi: peek poke i32 negative"
  (define p (ffi-malloc 4))
  (ffi-poke p 4 -42)
  (assert (eq? -42 (ffi-peek p 4 #t)))
  (ffi-free p))
(deftest "ffi: qsort callback"
  (define libc (ffi-dlopen-self))
  (define qsort (ffi-dlsym libc "qsort"))
  (define n 5)
  (define bytes (* n 8))
  (define arr (ffi-malloc bytes))
  (ffi-poke-f64 arr 3)
  (ffi-poke-f64 (+ arr 8) 1)
  (ffi-poke-f64 (+ arr 16) 4)
  (ffi-poke-f64 (+ arr 24) 1)
  (ffi-poke-f64 (+ arr 32) 5)
  (define cmp-id (ffi-register-callback
    (lambda (a b)
      (if (< (ffi-peek-f64 a) (ffi-peek-f64 b)) -1
        (if (> (ffi-peek-f64 a) (ffi-peek-f64 b)) 1 0)))))
  (define cmp (ffi-callback-ptr cmp-id))
  (ffi-call-void qsort (list arr n 8 cmp) nil)
  (assert (< (abs (- 1 (ffi-peek-f64 arr))) 1e-9))
  (ffi-release-callback cmp-id)
  (ffi-free arr))
(deftest "ffi: callback error is deferred"
  (define libc (ffi-dlopen-self))
  (define qsort (ffi-dlsym libc "qsort"))
  (define arr (ffi-malloc 16))
  (ffi-poke-f64 arr 2)
  (ffi-poke-f64 (+ arr 8) 1)
  (define id (ffi-register-callback (lambda (a b) (error "boom"))))
  (define err (try (lambda ()
    (ffi-call-void qsort (list arr 2 8 (ffi-callback-ptr id)) nil)
    #t)
    (lambda (e) e)))
  (assert (equal? "boom" err))
  (ffi-release-callback id)
  (ffi-free arr))
(deftest "ffi: many ffi calls in a loop"
  (define libc (ffi-dlopen-self))
  (define strlen (ffi-dlsym libc "strlen"))
  (define s (ffi-cstr "x"))
  (define n (reduce (range 200) (lambda (acc _) (+ acc (ffi-call-i64 strlen (list s) nil))) 0))
  (assert (< (abs (- 200 n)) 1e-9))
  (ffi-free s))
(deftest "ffi: libm pow mixes int and double"
  (define libm (try (lambda () (ffi-dlopen "libm.dylib")) (lambda (e) (ffi-dlopen "libm.so.6"))))
  (assert libm)
  (define pow (ffi-dlsym libm "pow"))
  (define r (ffi-call-f64 pow nil (list 2 10)))
  (assert (< (abs (- r 1024)) 1e-6))
  (ffi-dlclose libm))
(deftest "ffi: call/cc inside callback is an error"
  (define libc (ffi-dlopen-self))
  (define qsort (ffi-dlsym libc "qsort"))
  (define arr (ffi-malloc 16))
  (ffi-poke-f64 arr 2)
  (ffi-poke-f64 (+ arr 8) 1)
  (define id (ffi-register-callback (lambda (a b) (call/cc (lambda (k) 0)))))
  (define msg (try (lambda ()
    (ffi-call-void qsort (list arr 2 8 (ffi-callback-ptr id)) nil))
    (lambda (e) e)))
  (assert (equal? "TinyLisp: a continuation cannot cross an FFI callback" msg))
  (ffi-release-callback id)
  (ffi-free arr))
(deftest "ffi dsl: ffi-build-call strlen"
  (load "src/lib/ffi.lisp")
  (define libc (ffi-dlopen-self))
  (define strlen (lambda (s) (ffi-build-call (ffi-dlsym libc "strlen") 'int (list (list s 'string)))))
  (assert (eq? 5 (strlen "hello"))))

(run-tests)