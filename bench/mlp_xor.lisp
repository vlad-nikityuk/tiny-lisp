; A 2-8-1 MLP with relu learns XOR by SGD, on the scalar autograd of microgpt (examples/autograd.lisp).
(load "bench/prelude.lisp")
(load "examples/autograd.lisp")

(define xs '((0 0) (0 1) (1 0) (1 1)))
(define ys '(0 1 1 0))
(define n-hidden 8)
(define w1 (for/list (_ (range n-hidden)) (for/list (_ (range 2)) (Value (- (* (rand) 2) 1) '() '()))))
(define b1 (for/list (_ (range n-hidden)) (const 0)))
(define w2 (for/list (_ (range n-hidden)) (Value (- (* (rand) 2) 1) '() '())))
(define b2 (const 0))
(define params (concat (flatten w1) b1 w2 (list b2)))

(defn forward (x)
  (define h (for/list ((row b) (zip w1 b1)) (vrelu (reduce (for/list ((wi xi) (zip row x)) (val wi * xi)) v+ b))))
  (reduce (for/list ((w hi) (zip w2 h)) (val w * hi)) v+ b2))

(define loss nil)
(for (step (range 1200))
  (set! loss (const 0))
  (for ((x y) (zip xs ys))
    (define diff (val (forward x) - y))
    (set! loss (val loss + diff * diff)))
  (set! loss (val loss * (/ 1 (len xs))))
  (for (p params)
    (set-grad! p 0))
  (backward loss)
  (for (p params)
    (set-data! p (- (data p) (* 0.05 (grad p)))))
  (if (eq? (mod step 50) 0) (print step (floor (* (data loss) 1000000)))))
(print (floor (* (data loss) 1000000)) (floor (* (data (forward (at xs 1))) 1000000)))
