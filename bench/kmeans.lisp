; k-means with k = 4 on 3000 points from four blobs, 80 iterations.
(load "bench/prelude.lisp")

(define k 4)
(define centers '((-3.0 -3.0) (3.0 -3.0) (-3.0 3.0) (3.0 3.0)))
(define points
  (for/list (i (range 3000))
    (define c (at centers (mod i k)))
    (list (+ (at c 0) (* (- (rand) 0.5) 4)) (+ (at c 1) (* (- (rand) 0.5) 4)))))

(define cent (list (list (at (at points 0) 0) (at (at points 0) 1)) (list (at (at points 1) 0) (at (at points 1) 1))
                   (list (at (at points 2) 0) (at (at points 2) 1)) (list (at (at points 3) 0) (at (at points 3) 1))))
(define counts nil)
(define inertia 0.0)
(for (it (range 80))
  (define sums (for/list (_ (range k)) (list 0.0 0.0)))
  (set! counts (zeros k))
  (set! inertia 0.0)
  (for (p points)
    (define best 0)
    (define best-d 1e18)
    (for (c (range k))
      (define dx (- (at p 0) (at (at cent c) 0)))
      (define dy (- (at p 1) (at (at cent c) 1)))
      (define d (+ (* dx dx) (* dy dy)))
      (if (< d best-d)
        (begin
          (set! best-d d)
          (set! best c))))
    (at+= (at sums best) 0 (at p 0))
    (at+= (at sums best) 1 (at p 1))
    (at+= counts best 1)
    (+= inertia best-d))
  (for (c (range k))
    (if (> (at counts c) 0)
      (vset! cent c (list (/ (at (at sums c) 0) (at counts c)) (/ (at (at sums c) 1) (at counts c)))))))
(apply print (concat counts (list (floor (* inertia 10000)) (floor (* (at (at cent 0) 0) 1000000)) (floor (* (at (at cent 3) 1) 1000000)))))
