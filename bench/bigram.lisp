; A character bigram language model, as in makemore: count pairs over examples/names.txt, score the data with
; add-one smoothing, then sample 4000 names.
(load "bench/prelude.lisp")

(define docs (filter (split (read-file "examples/names.txt") newline) (lambda (line) line)))
(define uchars (split "abcdefghijklmnopqrstuvwxyz" ""))
(define BOS 26)
(define V 27)
(defn index-of (l x) (index-from l x 0))
(defn index-from (l x i) (if (eq? x (at l i)) i (index-from l x (+ i 1))))
(defn tokens-of (doc) (concat (list BOS) (for/list (ch (split doc "")) (index-of uchars ch)) (list BOS)))

(define N (for/list (_ (range V)) (zeros V)))
(for (doc docs)
  (define tokens (tokens-of doc))
  (for ((a b) (zip tokens (rest tokens)))
    (at+= (at N a) b 1)))

(define nll 0.0)
(define n 0)
(for (epoch (range 20))
  (set! nll 0.0)
  (set! n 0)
  (for (doc docs)
    (define tokens (tokens-of doc))
    (for ((a b) (zip tokens (rest tokens)))
      (define row (at N a))
      (define p (/ (+ (at row b) 1) (+ (sum row) V)))
      (+= nll (- 0 (log p)))
      (+= n 1))))
(print n (floor (* (/ nll n) 1000000)))

; sample one name: the length and a checksum of the characters
(defn sample (token length checksum)
  (define row (at N token))
  (define r (* (rand) (+ (sum row) V)))
  (define nxt (draw row r 0 0))
  (if (|| (eq? nxt BOS) (eq? length 20))
    (list length checksum)
    (sample nxt (+ length 1) (+ checksum (* nxt (+ length 1))))))
(defn draw (row r j acc)
  (define acc2 (+ acc (at row j) 1))
  (if (|| (< r acc2) (eq? j (- V 1))) j (draw row r (+ j 1) acc2)))

(define chars 0)
(define checksum 0)
(for (i (range 4000))
  (define result (sample BOS 0 0))
  (+= chars (at result 0))
  (+= checksum (at result 1)))
(print chars checksum)
