; Conway's game of life on a 80 x 80 torus, 100 generations from a random start.
(load "bench/prelude.lisp")

(define h 80)
(define w 80)
(define grid (for/list (_ (range h)) (for/list (_ (range w)) (if (< (rand) 0.3) 1 0))))

(defn step (g)
  (define new (for/list (_ (range h)) (zeros w)))
  (for (y (range h))
    (for (x (range w))
      (define n 0)
      (for (dy '(-1 0 1))
        (for (dx '(-1 0 1))
          (if (|| (not (eq? dy 0)) (not (eq? dx 0)))
            (+= n (at (at g (mod (+ y dy) h)) (mod (+ x dx) w))))))
      (if (|| (eq? n 3) (&& (eq? n 2) (eq? (at (at g y) x) 1)))
        (vset! (at new y) x 1))))
  new)

(for (generation (range 100))
  (set! grid (step grid)))
(define alive 0)
(define checksum 0)
(for (y (range h))
  (for (x (range w))
    (+= alive (at (at grid y) x))
    (+= checksum (* (at (at grid y) x) (+ (* y w) x)))))
(print alive checksum)
