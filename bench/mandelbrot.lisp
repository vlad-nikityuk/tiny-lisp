; The Mandelbrot set on a 300 x 300 grid: escape times with at most 200 iterations. (The `while` is a tail call.)
(load "bench/prelude.lisp")

(defn escape-time (cr ci max-iter)
  (escape-loop cr ci max-iter 0.0 0.0 0))
(defn escape-loop (cr ci max-iter zr zi i)
  (if (< i max-iter)
    (if (<= (+ (* zr zr) (* zi zi)) 4.0)
      (escape-loop cr ci max-iter (+ (- (* zr zr) (* zi zi)) cr) (+ (* 2.0 zr zi) ci) (+ i 1))
      i)
    i))

(define size 300)
(define max-iter 200)
(define inside 0)
(define total 0)
(for (py (range size))
  (for (px (range size))
    (define i (escape-time (+ -2.0 (/ (* 3.0 px) size)) (+ -1.5 (/ (* 3.0 py) size)) max-iter))
    (+= total i)
    (if (eq? i max-iter) (+= inside 1))))
(print inside total)
