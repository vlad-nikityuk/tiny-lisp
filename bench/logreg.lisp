; Logistic regression on two noisy blobs, full-batch gradient descent, plain floats.
(load "bench/prelude.lisp")

(define n 300)
(define xs (zeros n))
(define ys (zeros n))
(for (i (range n))
  (define c (mod i 2))
  (define cx (if c 1.0 -1.0))
  (vset! xs i (list (+ cx (* (- (rand) 0.5) 2)) (+ (* cx 0.5) (* (- (rand) 0.5) 2))))
  (vset! ys i c))

(define w (list 0.0 0.0))
(define b 0.0)
(define loss 0.0)
(for (epoch (range 2000))
  (define gw (list 0.0 0.0))
  (define gb 0.0)
  (set! loss 0.0)
  (for ((x y) (zip xs ys))
    (define z (+ (* (at w 0) (at x 0)) (* (at w 1) (at x 1)) b))
    (define p (/ 1 (+ 1 (exp (- 0 z)))))
    (+= loss (- 0 (+ (* y (log p)) (* (- 1 y) (log (- 1 p))))))
    (define err (- p y))
    (at+= gw 0 (* err (at x 0)))
    (at+= gw 1 (* err (at x 1)))
    (+= gb err))
  (vset! w 0 (- (at w 0) (/ (* 0.5 (at gw 0)) n)))
  (vset! w 1 (- (at w 1) (/ (* 0.5 (at gw 1)) n)))
  (-= b (/ (* 0.5 gb) n)))

(define correct 0)
(for ((x y) (zip xs ys))
  (define z (+ (* (at w 0) (at x 0)) (* (at w 1) (at x 1)) b))
  (if (eq? (> z 0) (eq? y 1)) (+= correct 1)))
(print (floor (* (/ loss n) 1000000)) correct (floor (* (at w 0) 1000000)) (floor (* b 1000000)))
